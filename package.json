{
  "name": "weddingflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply weddingflow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply weddingflow-db --remote",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@clerk/nextjs": "^6.5.0",
    "drizzle-orm": "^0.36.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.454.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "class-variance-authority": "^0.7.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "date-fns": "^4.1.0",
    "qrcode": "^1.5.4",
    "svix": "^1.36.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/qrcode": "^1.5.5",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "wrangler": "^4.0.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.1.0",
    "tsx": "^4.19.1"
  }
}
